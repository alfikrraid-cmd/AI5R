          }
        ]
      ]
    },
    "Check Existing Seal": {
      "main": [
        [
          {
            "node": "Check Seal Conflict",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Seal Conflict": {
      "main": [
        [
          {
