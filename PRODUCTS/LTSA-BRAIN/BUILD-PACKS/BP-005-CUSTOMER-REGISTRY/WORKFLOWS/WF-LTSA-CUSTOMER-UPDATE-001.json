{
  "name": "WF-LTSA-CUSTOMER-UPDATE-001",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "PUT",
        "path": "ltsa/customer/update",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-ltsa-customer-update",
      "name": "PUT /ltsa/customer/update",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\n\nif (!body.id) {\n  throw new Error('id is required');\n}\n\nconst updatable = [\n  'customer_code', 'customer_name', 'customer_type', 'industry', 'tax_id',\n  'billing_email', 'phone', 'address', 'city', 'province', 'country',\n  'status', 'notes'\n];\n\nconst fields = {};\nfor (const key of updatable) {\n  if (body[key] !== undefined) {\n    fields[key] = body[key];\n  }\n}\n\nif (Object.keys(fields).length === 0) {\n  throw new Error('at least one updatable field is required');\n}\n\nreturn [{\n  json: {\n    id: body.id,\n    fields\n  }\n}];"
      },
      "id": "validate-update-input",
      "name": "Validate Update Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "jsCode": "const { id, fields } = $json;\nconst keys = Object.keys(fields);\n\nconst setClauses = keys.map((key, idx) => `${key} = $${idx + 1}`);\nsetClauses.push('updated_at = NOW()');\n\nconst params = keys.map((key) => fields[key]);\nparams.push(id);\n\nconst query = `UPDATE customer_registry SET ${setClauses.join(', ')} WHERE id = $${params.length} RETURNING *;`;\n\nreturn [{\n  json: {\n    id,\n    query,\n    params\n  }\n}];"
      },
      "id": "build-update-statement",
      "name": "Build Update Statement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.query }}",
        "options": {
          "queryReplacement": "={{ $json.params }}"
        }
      },
      "id": "update-customer-postgres",
      "name": "Update Customer",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [780, 0],
      "credentials": {
        "postgres": {
          "id": "hzgFaX04t1nL01vF",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first()?.json;\n\nif (!row || !row.id) {\n  return [{\n    json: {\n      statusCode: 404,\n      success: false,\n      message: 'Customer not found',\n      data: null\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    statusCode: 200,\n    success: true,\n    message: 'Customer updated successfully',\n    data: row\n  }\n}];"
      },
      "id": "check-update-result",
      "name": "Check Update Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: $json.success, message: $json.message, data: $json.data } }}",
        "options": {
          "responseCode": "={{ $json.statusCode }}"
        }
      },
      "id": "respond-customer-update",
      "name": "Respond Update",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1300, 0]
    }
  ],
