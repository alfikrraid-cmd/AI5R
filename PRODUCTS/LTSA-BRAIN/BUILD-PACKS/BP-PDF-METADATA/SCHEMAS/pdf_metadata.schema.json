{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PDF_METADATA",
  "type": "object",
  "properties": {
    "pdf_metadata_id": {
      "type": "string"
    },
    "pdf_document_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "creation_date": {
      "type": "string",
      "format": "date-time"
    },
    "modification_date": {
      "type": "string",
      "format": "date-time"
    },
    "pdf_version": {
      "type": "string"
    }
  },
  "required": [
    "pdf_metadata_id",
    "pdf_document_id"
  ]
}
