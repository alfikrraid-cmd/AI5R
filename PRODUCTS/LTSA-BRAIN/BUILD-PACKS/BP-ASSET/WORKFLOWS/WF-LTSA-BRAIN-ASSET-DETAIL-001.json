    {
      "parameters": {
        "jsCode": "const row = $input.first()?.json;\n\nif (!row || !row.asset_code) {\n  return [{\n    json: {\n      statusCode: 404,\n      success: false,\n      message: 'Asset not found',\n      data: null\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    statusCode: 200,\n    success: true,\n    message: 'Asset detail found',\n    data: row\n  }\n}];"
      },
