{
  "name": "WF-LTSA-BRAIN-PDF-ACQUISITION-JOB-CREATE-001",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ltsa/pdf-acquisition-job/create",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-pdf-acquisition-job-create",
      "name": "Webhook Create PDF Acquisition Job",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst ALLOWED_STATUSES = ['PENDING', 'IN_PROGRESS', 'COMPLETED', 'FAILED'];\n\nif (!body.pdf_acquisition_job_id) {\n  throw new Error('pdf_acquisition_job_id is required');\n}\n\nif (!body.knowledge_source_id) {\n  throw new Error('knowledge_source_id is required');\n}\n\nif (!body.pdf_document_id) {\n  throw new Error('pdf_document_id is required');\n}\n\nconst status = body.status || 'PENDING';\nif (!ALLOWED_STATUSES.includes(status)) {\n  throw new Error('status must be one of: ' + ALLOWED_STATUSES.join(', '));\n}\n\nreturn [\n  {\n    json: {\n      pdf_acquisition_job_id: body.pdf_acquisition_job_id,\n      knowledge_source_id: body.knowledge_source_id,\n      pdf_document_id: body.pdf_document_id,\n      status\n    }\n  }\n];"
      },
      "id": "validate-pdf-acquisition-job-input",
      "name": "Validate PDF Acquisition Job Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT pdf_acquisition_job_id\nFROM pdf_acquisition_job\nWHERE pdf_acquisition_job_id = $1\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$json.pdf_acquisition_job_id] }}"
        }
      },
      "id": "check-existing-pdf-acquisition-job",
      "name": "Check Existing PDF Acquisition Job",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [520, 0],
      "credentials": {
        "postgres": {
          "id": "hzgFaX04t1nL01vF",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const existing = $input.first()?.json;\nconst input = $('Validate PDF Acquisition Job Input').first().json;\n\nreturn [{\n  json: {\n    ...input,\n    _conflict: !!(existing && existing.pdf_acquisition_job_id)\n  }\n}];"
      },
      "id": "check-pdf-acquisition-job-conflict",
      "name": "Check PDF Acquisition Job Conflict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "conflict-check",
              "leftValue": "={{ $json._conflict }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-pdf-acquisition-job-conflict",
      "name": "IF PDF Acquisition Job Exists",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1040, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, message: \"pdf_acquisition_job_id already exists: \" + $json.pdf_acquisition_job_id } }}",
        "options": {
          "responseCode": 409
        }
      },
      "id": "respond-pdf-acquisition-job-conflict",
      "name": "Respond Conflict",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1300, 140]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO pdf_acquisition_job (\n  pdf_acquisition_job_id,\n  knowledge_source_id,\n  pdf_document_id,\n  status\n)\nVALUES (\n  $1, $2, $3, $4\n)\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ [$json.pdf_acquisition_job_id, $json.knowledge_source_id, $json.pdf_document_id, $json.status] }}"
        }
      },
      "id": "insert-pdf-acquisition-job-postgres",
      "name": "Insert PDF Acquisition Job to PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1300, -140],
      "credentials": {
        "postgres": {
          "id": "hzgFaX04t1nL01vF",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, message: \"PDF Acquisition Job created successfully\", data: $json } }}",
        "options": {}
