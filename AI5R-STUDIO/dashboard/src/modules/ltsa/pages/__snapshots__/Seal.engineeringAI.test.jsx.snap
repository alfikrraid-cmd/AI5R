            LTSA Covered
             · 
            Stock
             
            Unknown
          </span>
        </div>
        <div
          class="action-bar-actions"
        >
          <button
            class="btn-link"
            data-od-id="action-bar-open-pump"
            type="button"
          >
            Buka Pump →
          </button>
          <button
            class="btn-primary"
            data-od-id="action-bar-generate-recommendation"
            type="button"
          >
            Buat Rekomendasi
          </button>
        </div>
      </div>
    </div>
    <div
      class="drawer-overlay"
      data-open="false"
    />
    <div
      aria-label="Seal Drawing"
      class="drawer"
      data-open="false"
      role="dialog"
    >
      <div
        class="drawer-head"
      >
        <h3
          class="drawer-title"
        >
          Seal Drawing
        </h3>
        <button
          aria-label="Close"
          class="icon-btn"
          data-od-id="drawer-close"
          type="button"
        >
          <svg
            fill="none"
            height="16"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.6"
            viewBox="0 0 24 24"
            width="16"
          >
            <path
              d="M18 6 6 18M6 6l12 12"
            />
          </svg>
        </button>
      </div>
      <div
        class="drawer-body"
      >
        <div
          class="drawing-thumb"
        />
        <p>
          Belum ada data drawing — Drawing Workspace belum memiliki backend.
        </p>
      </div>
    </div>
    <div
      class="drawer-overlay"
      data-open="false"
    />
    <div
      aria-label="Generate Recommendation"
      class="drawer"
      data-open="false"
      role="dialog"
    >
      <div
        class="drawer-head"
      >
        <h3
          class="drawer-title"
        >
          Generate Recommendation
        </h3>
        <button
          aria-label="Close"
          class="icon-btn"
          data-od-id="drawer-close"
          type="button"
        >
          <svg
            fill="none"
            height="16"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.6"
            viewBox="0 0 24 24"
            width="16"
          >
            <path
              d="M18 6 6 18M6 6l12 12"
            />
          </svg>
        </button>
      </div>
      <div
        class="drawer-body"
      >
        <p>
          No action required. In service on both Boiler Feedwater units.
        </p>
        <div
          style="margin-bottom: var(--space-5);"
        >
          <span
            class="eyebrow"
            style="display: block; margin-bottom: var(--space-2);"
          >
            Preferred Seal
          </span>
          <div
            class="part-item"
          >
            <div
              class="part-row"
            >
              <span
                class="part-name"
              >
                SC-002
              </span>
              <span
                class="stock-flag ok"
              >
                Direkomendasikan
              </span>
            </div>
            <div
              class="part-meta"
            >
              Interchange tercatat pada Seal Registry
            </div>
          </div>
        </div>
        <button
          class="btn-primary"
          data-od-id="mark-reviewed-btn"
          style="margin-top: var(--space-2);"
          type="button"
        >
          Tandai Sudah Ditinjau
        </button>
      </div>
    </div>
    <div
      class="toast"
      data-od-id="toast"
      data-open="false"
    />
  </div>
</div>
`;
