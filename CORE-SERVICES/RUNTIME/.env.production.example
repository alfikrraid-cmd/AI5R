AI5R_ENV=production
AI5R_VERSION=0.1.0
AI5R_DOMAIN=osa-system.com
AI5R_PRODUCT_NAME=LTSA-BRAIN
AI5R_LOG_LEVEL=INFO
AI5R_TIMEZONE=Asia/Jakarta
AI5R_BACKUP_ROOT=/var/backups/ai5ros
AI5R_BACKUP_RETENTION_DAYS=14
AI5R_HEALTH_TIMEOUT_SECONDS=10
AI5R_HEALTHCHECK_INTERVAL=15s
AI5R_HEALTHCHECK_TIMEOUT=5s
AI5R_HEALTHCHECK_RETRIES=5
AI5R_HEALTHCHECK_START_PERIOD=30s
AI5R_VOLUME_PREFIX=ai5ros-prod
AI5R_COMPOSE_PROJECT=ai5ros-prod

# Host-owned public ingress. Existing system nginx/certbot should route
# https://osa-system.com to the internal compose gateway/upstreams.
AI5R_DASHBOARD_PORT=5174
AI5R_API_PORT=8000
AI5R_N8N_PORT=5678
AI5R_MINIO_API_PORT=9000
AI5R_NGINX_PORT=8080

AI5R_DASHBOARD_PUBLIC_URL=https://osa-system.com
AI5R_API_PUBLIC_URL=https://osa-system.com
# Same public base host as dashboard/API; compose nginx routes n8n /rest/ and /webhook/ paths.
AI5R_N8N_PUBLIC_URL=https://osa-system.com
AI5R_MINIO_PUBLIC_URL=http://127.0.0.1:9000
AI5R_NGINX_PUBLIC_URL=https://osa-system.com

AI5R_CORS_ORIGINS=https://osa-system.com

# Application images: pin these to the approved release tag before deploy.
AI5R_DASHBOARD_IMAGE_REPO=ai5r/dashboard
AI5R_API_IMAGE_REPO=ai5r/api
AI5R_POSTGRES_IMAGE=postgres:16-alpine
AI5R_NEO4J_IMAGE=neo4j:5.26-community
AI5R_REDIS_IMAGE=redis:7.4-alpine
AI5R_N8N_IMAGE=n8nio/n8n:1.115.3
AI5R_MINIO_IMAGE=minio/minio:RELEASE.2025-02-28T09-55-16Z
AI5R_NGINX_IMAGE=nginx:1.27-alpine
AI5R_GOTENBERG_IMAGE=gotenberg/gotenberg:8

# Production secrets. Replace every value on the host only. Do not commit
# the real production .env file.
#
# This file must live at CORE-SERVICES/RUNTIME/.env on the host (compose.
# yaml's api service bind-mounts ./.env, relative to itself, into the
# container -- MWO-LTSA-IMPORT-PROD-COMPOSE-ENV-001). Do NOT set
# AI5R_IMPORT_ENV_FILE here -- compose.yaml already sets it, inside the
# container, to that same file's fixed in-container path; a host absolute
# path in this var would be meaningless inside the container and is not
# read from here.
AI5R_POSTGRES_DB=ai5r_runtime
AI5R_POSTGRES_PORT=5432
AI5R_LTSA_POSTGRES_DB=ltsa_brain
AI5R_POSTGRES_USER=ai5r
AI5R_POSTGRES_PASSWORD=REPLACE_WITH_PRODUCTION_POSTGRES_PASSWORD_32_CHARS_MIN

AI5R_NEO4J_USERNAME=neo4j
AI5R_NEO4J_PASSWORD=REPLACE_WITH_PRODUCTION_NEO4J_PASSWORD_32_CHARS_MIN

AI5R_REDIS_PASSWORD=REPLACE_WITH_PRODUCTION_REDIS_PASSWORD_32_CHARS_MIN

AI5R_N8N_ENCRYPTION_KEY=REPLACE_WITH_PRODUCTION_N8N_ENCRYPTION_KEY_32_CHARS_MIN

AI5R_MINIO_ROOT_USER=ai5rminio
AI5R_MINIO_ROOT_PASSWORD=REPLACE_WITH_PRODUCTION_MINIO_PASSWORD_32_CHARS_MIN

# Internal service routing. Keep n8n internal; system nginx owns public TLS.
AI5R_PUMP_GATEWAY_BASE_URL=http://n8n:5678/webhook
AI5R_WORK_ORDER_GATEWAY_BASE_URL=http://n8n:5678/webhook
AI5R_MAINTENANCE_HISTORY_GATEWAY_BASE_URL=http://n8n:5678/webhook
AI5R_PM_SCHEDULE_GATEWAY_BASE_URL=http://n8n:5678/webhook
AI5R_PM_OCCURRENCE_GATEWAY_BASE_URL=http://n8n:5678/webhook
AI5R_CM_REPORT_GATEWAY_BASE_URL=http://n8n:5678/webhook
AI5R_CONDITION_MONITORING_SCHEDULE_GATEWAY_BASE_URL=http://n8n:5678/webhook
AI5R_CONDITION_MONITORING_READING_GATEWAY_BASE_URL=http://n8n:5678/webhook
AI5R_SEAL_GATEWAY_BASE_URL=http://n8n:5678/webhook
AI5R_SEAL_STOCK_GATEWAY_BASE_URL=http://n8n:5678/webhook
AI5R_SEAL_PUMP_COMPATIBILITY_GATEWAY_BASE_URL=http://n8n:5678/webhook
AI5R_SEAL_ENGINEERING_DOCUMENT_GATEWAY_BASE_URL=http://n8n:5678/webhook
AI5R_INSTALLATION_GATEWAY_BASE_URL=http://n8n:5678/webhook
